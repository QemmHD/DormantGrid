{
  "name": "dormant-grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dg/game",
    "build": "npm run build -w @dg/game",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && node tools/check-bundle.mjs && node tools/check-secrets.mjs",
    "smoke": "node tests/smoke.mjs",
    "assets:ingest": "node tools/ingest.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
